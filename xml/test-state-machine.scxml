<?xml version="1.0" encoding="UTF-8"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" name="Hotvalve_Stress_test">
	<datamodel>
		<data expr="0.0" id="Pressure_in_bar" />
		<data expr="0.0" id="bellowhotvalves_bar" />
		<data expr="0.0" id="hotvalves_vacuum_onoff" />
		<data expr="0.0" id="hotvalves_pressure_onoff" />
		<data expr="0.0" id="VacuumPump_onoff" />
		<data expr="0.0" id="Inside_Oven" />
		<data expr="0.0" id="Cabinet_back" />
		<data expr="0.0" id="AirFlow_lpm" />
		<data expr="0.0" id="ovenarea1_target" />
		<data expr="1.5" id="conf_upperlimit_press" />
		<data expr="-0.3" id="conf_lowerlimit_press" />
		<data expr="0.5" id="conf_upperlimit_flow" />
		<data expr="5" id="conf_lowerlimit_test_flow" />
		<data expr="10" id="conf_holdtime_press" />
		<data expr="3" id="conf_holdtime_vac" />
		<data expr="20" id="conf_holdtime_error" />
		<data expr="0.0" id="this_known_state" />
		<data expr="false" id="this_leaking_error" />
		<data expr="false" id="this_no_argon" />
		<data expr="0" id="this_counter" />
		<data expr="false" id="this_status_failed" />
	</datamodel>
	<state id="main_region">
		<initial>
			<transition target="off" type="internal">
			</transition>
		</initial>
		<state id="off">
			<onentry>
				 <assign location="this_known_state" expr="1.0"/>
			</onentry>
			<transition event="BeginTest"  target="test_running">
			</transition>
			<transition event="reset"  target="Reset_counter">
			</transition>
		</state>
		<state id="test_running">
			<onexit>
				 <assign location="hotvalves_pressure_onoff" expr="0"/>
				 <assign location="hotvalves_vacuum_onoff" expr="0"/>
				 <assign location="VacuumPump_onoff" expr="0"/>
			</onexit>
			<initial>
				<transition target="pressure_up" type="internal">
				</transition>
			</initial>
			<state id="pressure_up">
				<onentry>
					<send event="pressure_up_t_1_timeEvent_0" delayexpr="conf_holdtime_error * 1000"/>
				</onentry>
				<onexit>
					<cancel sendid="pressure_up_t_1_timeEvent_0" />
				</onexit>
				<onentry>
					 <assign location="this_known_state" expr="2.1"/>
				</onentry>
				<transition event ="vector"  type="internal" >
					 <assign location="hotvalves_pressure_onoff" expr="1.0"/>
				</transition>
				<transition  cond="bellowhotvalves_bar &gt;= conf_upperlimit_press" target="Control_pressure">
				</transition>
				<transition event="pressure_up_t_1_timeEvent_0"  target="Error_Oven_stop">
				</transition>
			</state>
			<state id="Control_pressure">
				<onentry>
					<send event="Control pressure_t_1_timeEvent_0" delayexpr="conf_holdtime_error * 1000"/>
				</onentry>
				<onexit>
					<cancel sendid="Control pressure_t_1_timeEvent_0" />
				</onexit>
				<onentry>
					 <assign location="this_known_state" expr="2.2"/>
				</onentry>
				<transition  cond="AirFlow_lpm &lt;= conf_upperlimit_flow" target="Check_flow_lower">
				</transition>
				<transition event="Control pressure_t_1_timeEvent_0"  target="Leaking_error">
				</transition>
			</state>
			<state id="pressure_down">
				<onentry>
					 <assign location="this_known_state" expr="2.4"/>
				</onentry>
				<transition event ="vector"  type="internal" >
					 <assign location="hotvalves_vacuum_onoff" expr="1.0"/>
					 <assign location="VacuumPump_onoff" expr="1.0"/>
				</transition>
				<transition  cond="bellowhotvalves_bar &lt;= conf_lowerlimit_press" target="Check_flow_upper">
				</transition>
			</state>
			<state id="Check_flow_lower">
				<onentry>
					<send event="Check flow lower_t_0_timeEvent_0" delayexpr="conf_holdtime_press * 1000"/>
				</onentry>
				<onexit>
					<cancel sendid="Check flow lower_t_0_timeEvent_0" />
				</onexit>
				<onentry>
					 <assign location="this_known_state" expr="2.3"/>
				</onentry>
				<transition event="Check flow lower_t_0_timeEvent_0"  target="pressure_down">
				</transition>
			</state>
			<state id="Check_flow_upper">
				<onentry>
					<send event="Check flow upper_t_1_timeEvent_0" delayexpr="conf_holdtime_error * 1000"/>
				</onentry>
				<onexit>
					<cancel sendid="Check flow upper_t_1_timeEvent_0" />
				</onexit>
				<onentry>
					 <assign location="this_known_state" expr="2.5"/>
				</onentry>
				<transition  cond="AirFlow_lpm &gt;= conf_lowerlimit_test_flow" target="wait_low">
				</transition>
				<transition event="Check flow upper_t_1_timeEvent_0"  target="No_Argon">
				</transition>
			</state>
			<state id="Leaking_error">
				<onentry>
					 <assign location="this_leaking_error" expr="true"/>
				</onentry>
				<onexit>
					 <assign location="this_leaking_error" expr="false"/>
				</onexit>
				<transition event="vector"  target="Error_Oven_stop">
				</transition>
			</state>
			<state id="Counter">
				<onentry>
					<send event="Counter_t_0_timeEvent_0" delay="1s"/>
				</onentry>
				<onexit>
					<cancel sendid="Counter_t_0_timeEvent_0" />
				</onexit>
				<onentry>
					 <assign location="hotvalves_pressure_onoff" expr="0.0"/>
					 <assign location="hotvalves_vacuum_onoff" expr="0.0"/>
					 <assign location="VacuumPump_onoff" expr="0.0"/>
				</onentry>
				<onexit>
					 <assign location="this_counter" expr="this_counter + 1"/>
				</onexit>
				<transition event="Counter_t_0_timeEvent_0"  target="pressure_up">
				</transition>
			</state>
			<state id="wait_low">
				<onentry>
					<send event="wait_low_t_0_timeEvent_0" delayexpr="conf_holdtime_vac * 1000"/>
				</onentry>
				<onexit>
					<cancel sendid="wait_low_t_0_timeEvent_0" />
				</onexit>
				<onentry>
					 <assign location="this_known_state" expr="2.6"/>
				</onentry>
				<transition event="wait_low_t_0_timeEvent_0"  target="Counter">
				</transition>
			</state>
			<state id="No_Argon">
				<onentry>
					 <assign location="this_no_argon" expr="true"/>
				</onentry>
				<onexit>
					 <assign location="this_no_argon" expr="false"/>
				</onexit>
				<transition event="vector"  target="Error_Oven_stop">
				</transition>
			</state>
			<transition event="Stop"  target="Error_Oven_stop">
			</transition>
		</state>
		<state id="Reset_counter">
			<onentry>
				 <assign location="this_counter" expr="0"/>
			</onentry>
			<transition   target="off">
			</transition>
		</state>
		<state id="Error_Oven_stop">
			<onentry>
				 <assign location="this_status_failed" expr="true"/>
				 <assign location="ovenarea1_target" expr="0.0"/>
			</onentry>
			<transition event="vector"  target="off">
			</transition>
		</state>
	</state>
</scxml>