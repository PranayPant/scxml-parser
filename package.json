{
  "name": "scxml-parser",
  "version": "0.0.1",
  "description": "Headless SCXML parser, AST validator, and serializer library.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --write .",
    "lint:check": "biome lint .",
    "check": "biome check src tests",
    "hooks:install": "lefthook install",
    "examples:ast": "node examples/ast-print.mjs",
    "examples:ast:cart": "node examples/ast-print.mjs examples/scxml/cart-checkout.scxml",
    "examples:ast:reservation": "node examples/ast-print.mjs examples/scxml/reservation.scxml",
    "examples:ast:auth": "node examples/ast-print.mjs examples/scxml/auth-login.scxml",
    "examples:mermaid": "node examples/ast-to-mermaid.mjs",
    "examples:mermaid:cart": "node examples/ast-to-mermaid.mjs examples/scxml/cart-checkout.scxml",
    "examples:mermaid:reservation": "node examples/ast-to-mermaid.mjs examples/scxml/reservation.scxml",
    "examples:mermaid:auth": "node examples/ast-to-mermaid.mjs examples/scxml/auth-login.scxml"
  },
  "keywords": [
    "scxml",
    "state-machine",
    "scxml-parser"
  ],
  "license": "MIT",
  "dependencies": {
    "fast-xml-parser": "^4.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "esbuild": "^0.20.0",
    "lefthook": "^2.1.10",
    "typescript": "^7.0.2",
    "vitest": "^1.0.0"
  }
}
