<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" initial="idle">
  <state id="idle">
    <transition event="start" target="running"/>
  </state>

  <parallel id="running">
    <state id="motor_region" initial="motor_idle">
      <state id="motor_idle">
        <transition event="go" target="motor_running"/>
      </state>
      <state id="motor_running"/>
    </state>

    <state id="sensor_region" initial="sensor_idle">
      <state id="sensor_idle">
        <transition event="poll" target="sensor_reading"/>
      </state>
      <state id="sensor_reading"/>
    </state>

    <parallel id="inner">
      <state id="sub_x"/>
      <state id="sub_y"/>
    </parallel>
  </parallel>

  <parallel id="five_way">
    <state id="region_a"/>
    <state id="region_b"/>
    <state id="region_c"/>
    <state id="region_d"/>
    <state id="region_e"/>
  </parallel>

  <final id="done"/>
</scxml>
